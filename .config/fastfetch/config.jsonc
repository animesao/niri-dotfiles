{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "cachyos_small",
        "color": {
            "1": "white",
            "2": "bright_black"
        },
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": {
            "keys": "white",
            "title": "white"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰌽 OS",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "white"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "white"
        },
        {
            "type": "cpu",
            "key": " CPU",
            "keyColor": "white"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "white"
        },
        {
            "type": "uptime",
            "key": "󰅐 Up",
            "keyColor": "white"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
